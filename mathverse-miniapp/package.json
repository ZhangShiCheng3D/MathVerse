{
  "name": "mathverse-miniapp",
  "version": "0.1.0",
  "private": true,
  "description": "数界 MathVerse — AI数学学习平台",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "build:h5": "taro build --type h5",
    "dev:weapp": "npm run build:weapp -- --watch",
    "dev:h5": "npm run build:h5 -- --watch",
    "test": "vitest run",
    "app:sync": "npm run build:h5 && npx cap sync android",
    "app:apk": "npm run app:sync && android\\gradlew.bat assembleDebug -p android"
  },
  "dependencies": {
    "@babel/preset-react": "^7.29.7",
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@tarojs/components": "^4.0.0",
    "@tarojs/helper": "^4.0.0",
    "@tarojs/plugin-framework-react": "^4.2.0",
    "@tarojs/plugin-platform-h5": "^4.2.0",
    "@tarojs/plugin-platform-weapp": "^4.2.0",
    "@tarojs/react": "^4.0.0",
    "@tarojs/runtime": "^4.0.0",
    "@tarojs/shared": "^4.0.0",
    "@tarojs/taro": "^4.0.0",
    "@tarojs/webpack5-runner": "^4.2.0",
    "babel-preset-taro": "^4.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@capacitor/cli": "^8.3.4",
    "@tarojs/cli": "^4.0.0",
    "@types/react": "^18.3.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.4.0",
    "vitest": "^4.1.8"
  }
}
